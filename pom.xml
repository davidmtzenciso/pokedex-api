<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.elatusdev</groupId>
  <artifactId>pokedex-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>pokedex-api</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>24</maven.compiler.release>

    <spring-boot.version>4.1.0</spring-boot.version>
    <springdoc.version>3.1.0</springdoc.version>
    <!-- the Boot 4.1.0 BOM pins 12.4.0; an imported BOM does not read this property, so the
         flyway artifacts below carry the version explicitly -->
    <flyway.version>13.2.0</flyway.version>
    <jjwt.version>0.13.0</jjwt.version>
    <archunit.version>1.5.0</archunit.version>
    <wiremock.version>3.13.1</wiremock.version>
    <testcontainers.version>1.21.4</testcontainers.version>
    <openapi-generator.version>7.24.0</openapi-generator.version>
    <jacoco.version>0.8.15</jacoco.version>
    <pitest.version>1.25.9</pitest.version>
    <pitest-junit5.version>1.2.3</pitest-junit5.version>
    <surefire.version>3.5.4</surefire.version>
    <enforcer.version>3.6.2</enforcer.version>
    <exec.version>3.6.1</exec.version>

    <!-- coverage gate -->
    <jacoco.line.min>0.90</jacoco.line.min>
    <jacoco.branch.min>0.90</jacoco.branch.min>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- first, and deliberately: the Boot BOM below pins flyway-core to 12.4.0, so without
           this the postgres and cockroachdb modules drag 12.4.0 back in and dependencyConvergence
           fails. The first matching entry wins, which is why this precedes the imports. -->
      <dependency>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-core</artifactId>
        <version>${flyway.version}</version>
      </dependency>
      <dependency>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-database-postgresql</artifactId>
        <version>${flyway.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Boot 4 split spring-boot-autoconfigure into per-technology modules. flyway-core alone
         puts Flyway on the classpath and nothing runs it: no FlywayAutoConfiguration, no
         schema history table, and a context that starts perfectly against an empty database. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- ES256 sign and verify. jjwt-impl and jjwt-jackson are runtime service providers:
         the compiler never sees them, and omitting either fails at the first Jwts call -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- generated *Api interfaces need these at compile time -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>${wiremock.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- source hygiene: no file headers, no Javadoc, no NOSONAR -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec.version}</version>
        <executions>
          <execution>
            <id>source-hygiene</id>
            <phase>validate</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>bash</executable>
              <arguments><argument>${project.basedir}/scripts/check-source-hygiene.sh</argument></arguments>
            </configuration>
          </execution>
          <!-- a throwaway ES256 keystore for the test run, so `mvn verify` is green on a
               clean clone without `make keys` first. It lives under target/ and is never
               the dev keystore: nothing signed here is valid anywhere else. -->
          <execution>
            <id>test-keystore</id>
            <phase>generate-test-resources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>bash</executable>
              <arguments><argument>${project.basedir}/scripts/generate-test-keystore.sh</argument></arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- the contract is authored by hand; these interfaces and DTOs are derived from it -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <id>generate-api</id>
            <phase>generate-sources</phase>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi/pokedex-api.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <apiPackage>com.elatusdev.pokedex.contract.api</apiPackage>
              <modelPackage>com.elatusdev.pokedex.contract.dto</modelPackage>
              <modelNameSuffix>DTO</modelNameSuffix>
              <!-- default interface methods return 501 for operations a stream has not
                   implemented yet, which is what lets three streams share one contract.
                   They need ApiUtil, so that one supporting file is generated and no other. -->
              <generateSupportingFiles>true</generateSupportingFiles>
              <supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <!-- every path starts /v1, so the default grouping would emit one V1Api -->
                <useTags>true</useTags>
                <documentationProvider>springdoc</documentationProvider>
                <useSpringBoot3>true</useSpringBoot3>
                <openApiNullable>false</openApiNullable>
                <useOptional>false</useOptional>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${enforcer.version}</version>
        <executions>
          <execution>
            <id>enforce</id>
            <phase>validate</phase>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <dependencyConvergence/>
                <requireReleaseDeps><onlyWhenRelease>true</onlyWhenRelease></requireReleaseDeps>
                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <excludes><exclude>**/*ComponentTest.java</exclude></excludes>
          <!-- application-test.yaml OVERRIDES the main configuration; it must not REPLACE
               it. A file named application.yaml in src/test/resources shadows the one in
               src/main/resources entirely, which silently drops the context path and every
               other main setting — and the symptom is a security chain that denies every
               public route. -->
          <systemPropertyVariables>
            <spring.profiles.active>test</spring.profiles.active>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <includes><include>**/*ComponentTest.java</include></includes>
          <systemPropertyVariables>
            <spring.profiles.active>test</spring.profiles.active>
          </systemPropertyVariables>
          <!-- spring-boot:repackage replaces the main artifact with a fat jar whose classes
               sit under BOOT-INF/classes. Failsafe defaults to that artifact, and the
               @SpringBootConfiguration package search then finds nothing. -->
          <classesDirectory>${project.build.outputDirectory}</classesDirectory>
        </configuration>
        <executions>
          <execution>
            <goals><goal>integration-test</goal><goal>verify</goal></goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <!-- generated code is not our code; gating it produces noise, not signal -->
          <excludes>
            <exclude>com/elatusdev/pokedex/contract/api/**</exclude>
            <exclude>com/elatusdev/pokedex/contract/dto/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution><id>prepare-unit</id><goals><goal>prepare-agent</goal></goals></execution>
          <execution>
            <id>prepare-it</id><goals><goal>prepare-agent-integration</goal></goals>
          </execution>
          <execution>
            <id>merge</id><phase>verify</phase><goals><goal>merge</goal></goals>
            <configuration>
              <fileSets>
                <fileSet>
                  <directory>${project.build.directory}</directory>
                  <includes><include>*.exec</include></includes>
                </fileSet>
              </fileSets>
              <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>report</id><phase>verify</phase><goals><goal>report</goal></goals>
            <configuration><dataFile>${project.build.directory}/jacoco-merged.exec</dataFile></configuration>
          </execution>
          <execution>
            <id>check</id><phase>verify</phase><goals><goal>check</goal></goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>${jacoco.line.min}</minimum></limit>
                    <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>${jacoco.branch.min}</minimum></limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions><execution><goals><goal>repackage</goal></goals></execution></executions>
      </plugin>

      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest.version}</version>
        <configuration>
          <targetClasses>
            <param>com.elatusdev.pokedex.*.domain.*</param>
            <param>com.elatusdev.pokedex.*.application.*</param>
          </targetClasses>
          <targetTests><param>com.elatusdev.pokedex.*</param></targetTests>
          <mutationThreshold>85</mutationThreshold>
          <mutators><mutator>STRONGER</mutator></mutators>
          <timestampedReports>false</timestampedReports>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest-junit5.version}</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>
</project>
